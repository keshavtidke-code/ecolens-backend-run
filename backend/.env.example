# Copy to .env and adjust. Real environment variables override this file.

# --- App ---
APP_NAME=EcoLens API
ENVIRONMENT=development        # development | testing | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (relative SQLite paths resolve from the directory you run commands in: backend/) ---
DATABASE_URL=sqlite:///./ecolens.db
DB_ECHO=false

# --- Security ---
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required to be a random 32+ char value when ENVIRONMENT=production.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated or JSON array) ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_ALLOW_CREDENTIALS=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console             # console | json

# --- Media storage ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# --- Weather + location (Open-Meteo and OpenStreetMap Nominatim: free, NO API keys) ---
EXTERNAL_LOOKUPS_ENABLED=true  # false = skip place/weather lookup on capture (offline dev)
PROVIDER_TIMEOUT_S=6
# Nominatim requires an identifying User-Agent. Put a real contact here before going live:
GEOCODING_USER_AGENT=EcoLens/0.1 (you@example.com)
GEOCODING_MIN_INTERVAL_S=1.0   # Nominatim policy: max 1 request/second
GEOCODING_CACHE_TTL_S=86400
WEATHER_CACHE_TTL_S=600
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# GEOCODING_URL=https://nominatim.openstreetmap.org/reverse

# --- Gemini vision perception (POST /observations/{id}/analyze) ---
# Create a key at https://aistudio.google.com/apikey . Leave blank to disable analysis (503 ai_not_configured).
GEMINI_API_KEY=
# Stable models as of Oct 2026: gemini-3.8-flash (default), gemini-3.5-flash-lite (cheaper).
# NOTE: gemini-2.5-flash and gemini-2.0-flash have been shut down by Google.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=60
GEMINI_MAX_OUTPUT_TOKENS=8192   # Gemini 3 counts thinking tokens against this; keep it generous
# GEMINI_TEMPERATURE=            # leave unset: Google recommends the model default for Gemini 3
ANALYSIS_STALE_AFTER_S=300       # an 'analyzing' status older than this may be re-run
# Perception confidence below this makes the lesson stage "cautious" (tentative wording, simpler challenge).
LOW_CONFIDENCE_THRESHOLD=0.5
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Ask-AI chat (POST /observations/{id}/chat) ---
CHAT_HISTORY_MESSAGES=10        # recent messages sent to Gemini as history
CHAT_MAX_ATTEMPTS=3             # Gemini attempts for timeouts / 429 / 5xx
CHAT_RETRY_BACKOFF_S=0.5        # first retry delay, doubles each retry
CHAT_REQUEST_TIMEOUT_S=25       # per Gemini attempt
CHAT_TOTAL_TIMEOUT_S=50         # overall deadline for one chat request
CHAT_RATE_LIMIT_PER_MINUTE=10   # per user, 0 disables
CHAT_RATE_LIMIT_PER_HOUR=100    # per user, 0 disables
