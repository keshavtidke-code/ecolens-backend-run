# Copy to .env and adjust. Real environment variables override this file.
# Auth is handled by Supabase — no SECRET_KEY / JWT fields needed.

# --- App ---
APP_NAME=EcoLens API
ENVIRONMENT=development        # development | testing | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database ---
# Local dev: SQLite (no setup needed)
DATABASE_URL=sqlite:///./ecolens.db
# Production (Supabase Transaction Pooler — IPv4, works on Render):
# DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_ECHO=false

# --- CORS (comma-separated or JSON array) ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://10.0.2.2:8081,http://10.0.2.2:19006
CORS_ALLOW_CREDENTIALS=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console             # console | json

# --- Media storage ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# --- Weather + location (Open-Meteo and OpenStreetMap Nominatim: free, NO API keys) ---
EXTERNAL_LOOKUPS_ENABLED=true  # false = skip place/weather lookup on capture (offline dev)
PROVIDER_TIMEOUT_S=15
# Nominatim requires an identifying User-Agent. Put a real contact here before going live:
GEOCODING_USER_AGENT=EcoLens/0.1 (you@example.com)
GEOCODING_MIN_INTERVAL_S=1.0   # Nominatim policy: max 1 request/second
GEOCODING_CACHE_TTL_S=86400
WEATHER_CACHE_TTL_S=600

# --- Gemini AI (POST /observations/{id}/analyze) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=60
GEMINI_MAX_OUTPUT_TOKENS=8192
ANALYSIS_STALE_AFTER_S=300
LOW_CONFIDENCE_THRESHOLD=0.5

# --- Chat ---
CHAT_HISTORY_MESSAGES=10
CHAT_MAX_ATTEMPTS=3
CHAT_RETRY_BACKOFF_S=0.5
CHAT_REQUEST_TIMEOUT_S=25
CHAT_TOTAL_TIMEOUT_S=50
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_HOUR=100

# --- Supabase Auth + DB ---
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=      # anon/public key
SUPABASE_SECRET_KEY=           # service_role key — used to verify JWTs (server-side only!)
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
